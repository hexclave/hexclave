# Auth
HEXCLAVE_BULLDOZER_SERVER_SECRET=mock_bulldozer_server_secret

# Sentry
BULLDOZER_JS_SENTRY_DSN=
BULLDOZER_JS_SENTRY_ENVIRONMENT=development

# Storage
HEXCLAVE_BULLDOZER_JS_LMDB_COMPRESSION=1
HEXCLAVE_BULLDOZER_JS_LMDB_PATH=.data/bulldozer-js-lmdb
HEXCLAVE_BULLDOZER_JS_USE_TMP_LMDB=0
HEXCLAVE_BULLDOZER_JS_LOW_LEVEL_BACKEND=

# Engine / debugging
HEXCLAVE_BULLDOZER_JS_DISABLE_PILEDRIVER_HEAP_READ_CACHE=0
HEXCLAVE_BULLDOZER_JS_SIMULATE_READ_MISS_DELAY_MS=
HEXCLAVE_BULLDOZER_EMIT_HANDLER_TIMING=0
