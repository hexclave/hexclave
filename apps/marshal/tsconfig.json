{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "esnext"
    ],
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "noErrorTruncation": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/live-proxy-fixture/*.mjs",
    "vitest.config.ts",
    "tsdown.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
