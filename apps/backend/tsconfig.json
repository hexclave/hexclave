{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "noErrorTruncation": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "skipLibCheck": true,
    "types": [
      "vitest/importMeta"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.?ts",
    "**/*.?tsx"
  ],
  "exclude": [
    "api",
    "node_modules",
    ".next/dev",
    "dist",
    "**/*.untracked.*",
    "**/*.untracked/**"
  ]
}
