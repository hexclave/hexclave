model OutgoingRequest {
  id String @id @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())

  qstashOptions       Json
  startedFulfillingAt DateTime?
  deduplicationKey    String?

  // Partial unique index on deduplicationKey WHERE startedFulfillingAt IS NULL
  // is created in a custom migration (not expressible in Prisma schema)
  @@index([startedFulfillingAt, createdAt])
  @@index([startedFulfillingAt, deduplicationKey])
}

enum StripeWebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
}

// Idempotency + recovery log for incoming Stripe webhook events. Each event is
// persisted synchronously (keyed on the Stripe `event.id`) before we ack 200 to
// Stripe, so redeliveries are deduped and the full `payload` of any
// PENDING/FAILED row can be replayed manually. Not tenancy-scoped: the Stripe
// account -> tenancy resolution happens during processing, not here.
model StripeWebhookEvent {
  id String @id @default(uuid()) @db.Uuid

  stripeEventId   String                   @unique
  eventType       String
  stripeAccountId String?
  payload         Json
  status          StripeWebhookEventStatus @default(PENDING)
  lastError       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?
}

// BulldozerStorageEngine is managed externally (see prisma.config.ts
// `tables.external`). It's created by migrations and interacted with
// via raw SQL — not through the Prisma client. Keeping it out of the
// Prisma schema avoids drift warnings for features Prisma can't represent
// (generated columns, self-referential FKs on jsonb[] columns, etc.).

model BulldozerTimeFoldQueue {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableStoragePath Json[]
  groupKey         Json
  rowIdentifier    String
  scheduledAt      DateTime @db.Timestamptz
  stateAfter       Json
  rowData          Json
  reducerSql       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@unique([tableStoragePath, groupKey, rowIdentifier], map: "BulldozerTimeFoldQueue_table_group_row_key")
  @@index([scheduledAt], map: "BulldozerTimeFoldQueue_scheduledAt_idx")
}

model BulldozerTimeFoldMetadata {
  key             String   @id
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  lastProcessedAt DateTime @db.Timestamptz
}

// BulldozerTimeFoldDownstreamCascade is managed externally (see
// prisma.config.ts `tables.external`). Same reason as BulldozerStorageEngine
// above: its primary key is on a JSONB[] column, which Prisma's @id
// attribute rejects ("fields that are marked as id must be required"; list
// types are treated as non-required). It's written only by bulldozer
// internals (declareTimeFoldTable.init()/.delete()) and read by
// public.bulldozer_timefold_process_queue() — never via the Prisma client.

model DeletedRow {
  id        String @id @default(uuid()) @db.Uuid
  tenancyId String @db.Uuid
  tableName String

  sequenceId             BigInt? @unique
  shouldUpdateSequenceId Boolean @default(true)

  primaryKey Json
  data       Json?

  deletedAt           DateTime  @default(now())
  startedFulfillingAt DateTime?

  @@index([tableName])
  @@index([tenancyId])
  // composite index for efficient querying of deleted rows by tenant and table, ordered by sequence
  @@index([tenancyId, tableName, sequenceId])
  @@index([shouldUpdateSequenceId, tenancyId], name: "DeletedRow_shouldUpdateSequenceId_idx")
}

// ================== Project secrets ==================
// Per-project credential values, write-only through the API
// (set/overwrite/delete, never read back) and envelope-encrypted with the same
// KMS flow as the data vault's server-side layer (`encryptWithKms`), so
// plaintext never touches this table. Only the feature consuming a secret
// decrypts it, server-side.
//
// Deployments are the only consumer today (`secret()` env vars in the config
// file's `services` export name a key here), but the store deliberately isn't
// deployments-specific — see @/lib/project-secrets.
//
// Keyed by project, not tenancy: these are infrastructure credentials that
// branches share by design, and a per-organization copy of an API key would be
// meaningless. If a consumer ever needs per-branch values, the intended shape is
// a nullable `branchId` (null = every branch) resolved
// exact-match-then-project-wide; that needs a partial unique index for the NULL
// case, which Prisma can't express, so it wants a hand-written migration.
model ProjectSecret {
  projectId String

  id String @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  key String
  // { edkBase64, ciphertextBase64 } from encryptWithKms()
  encrypted Json

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@unique([projectId, key])
}

// ================== Deployments ==================
// State for the Deployments app.
//
// A project owns DEPLOYMENT SOURCES; a source is deployed one or more times;
// each deployment ships a set of SERVICES. A source is one deploy file
// (hexclave.deploy.ts, named by its own `id` export) and what one
// `hexclave deploy` ships — one upload, one build — so a project deployed from
// several repositories gives each of them a source of its own. Service ids stay
// unique per PROJECT, so a reference never has to name a source.
//
// Service definitions come from the `services` export of the deploy file:
// `hexclave deploy` evaluates it and syncs the parts the server needs (build
// config, env var definitions) into DeploymentService rows, which are the
// authoritative server-side copy — the dashboard renders services from these
// rows and cannot edit them. Secret VALUES are never part of a definition: env
// vars of type "secret" only name a key in the ProjectSecret store above.
//
// Two things deliberately OUTLIVE the service that uses them, because the
// resource behind them does: a persistent volume (a disk with tenant data) is
// owned by the CLUSTER and merely mounted by a service, and a custom domain (a
// hostname with a certificate) is owned by the PROJECT and merely pointed at a
// service. Dropping a service from a deploy file tears the service down and
// leaves both behind, unattached, until someone deletes them explicitly.

model DeploymentSource {
  tenancyId String @db.Uuid

  id String @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The deploy file's own `id` export — which deploy file (and so which
  // repository) these services were deployed from. Deployments declared in
  // hexclave.config.ts, which has no id of its own, belong to a source named
  // after that file. Created implicitly by the first deploy that names it.
  sourceId String

  tenancy     Tenancy             @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  services    DeploymentService[]
  deployments Deployment[]
  volumes     DeploymentVolume[]

  @@id([tenancyId, id])
  @@unique([tenancyId, sourceId])
}

model DeploymentService {
  tenancyId String @db.Uuid

  id String @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Which deployment source last declared this service. A service belongs to
  // exactly one: the deploy file that declares it owns it, and a sync from
  // another source claiming the same id is refused rather than silently taking
  // it over.
  sourceRowId String @db.Uuid

  // The user-facing service id — the key of the record returned by the deploy
  // file's `services` export (e.g. "api"). Unique across the whole PROJECT, not
  // per source, which is what lets a reference name a service without naming
  // its source. It doubles as the Marshal service key.
  serviceId String

  // Set when the service's spec was first successfully applied to Marshal
  // (the Fly-backed runtime). Marshal apps have deterministic names, so there
  // is no foreign id to store, only the fact that provisioning happened.
  provisionedAt DateTime?

  // The definition as last synced from the deploy file's `services` export.
  // `definitionSyncId` is regenerated once per source sync and fenced by the
  // deploy that follows it, so two CLIs cannot silently combine one checkout's
  // source with another checkout's stored build settings and env definition.
  definitionSyncedAt DateTime?
  definitionSyncId   String?   @db.Uuid
  // How the service runs: "server" (one instance that suspends when idle, the
  // only kind that may mount a volume) or "serverless" (scales between the
  // bounds below, stops on scale-down).
  type          String @default("serverless")
  // Whether the service takes public ingress. A property of the SERVICE rather
  // than of a port: the runtime's proxy serves every declared port on every
  // address the app holds, so "public 3000, private 5432" is not a thing it can
  // do, and a per-port flag could only ever misdescribe it.
  //
  // A public service must be all-HTTP (raw TCP carries no SNI or Host, so a
  // shared public address cannot route it) and must declare at least one port.
  // Both are enforced in code rather than by a CHECK: they are facts about the
  // runtime we deploy onto, not about what these columns may contain, and are
  // expected to move — public TCP is a dedicated IPv4 away. See the migration.
  isPublic      Boolean @default(false)
  // The ports the container listens on, as a JSON object keyed by port number
  // with required `{ protocol }` values (see DeploymentPortDefinition). A "tcp" port is
  // raw and only a private service may declare one.
  ports         Json   @default("{}")
  minInstances  Int?
  maxInstances  Int?
  // Where the service's code lives inside the deployment source's upload, relative to the
  // deploy file. The build CONTEXT is the whole upload (a monorepo service
  // usually has to reach shared code above its own directory); this only scopes
  // where build detection starts.
  rootDirectory String?
  // The Dockerfile to build from, relative to the root of the uploaded source.
  // Null = no Dockerfile: the remote builder auto-detects the build with Railpack.
  dockerfilePath String?
  // An image, as a canonical fully-qualified reference with an explicit tag or
  // digest ("docker.io/library/postgres:16"). With no buildCommand it is the
  // image to RUN and the service is not built at all; with one it is the BASE
  // the service is built on, and rootDirectory says where in the upload the
  // build command runs. Mutually exclusive with dockerfilePath — each of them
  // says what the build starts from — enforced in code alongside the rest of the
  // definition validation rather than by a CHECK, for the same reason as
  // isPublic above.
  //
  // A TAG here is deliberately not resolved: this is what the author asked for,
  // and the digest it resolved to belongs to the deployment that pinned it.
  image String?
  // A single command line, run through `sh -c` while the image is BUILT. Null =
  // the base decides the build entirely. Its base is `image`, or
  // `dockerfilePath`'s Dockerfile (where it becomes a final appended RUN), or —
  // with neither — the Hexclave base image, which replaces Railpack
  // auto-detection.
  //
  // (The Vercel-era DeploymentService had a buildCommand column too, dropped
  // when deployments moved to containers. This one is not it: that one was a
  // framework build setting handed to Vercel, this one is a line of a Dockerfile
  // Marshal generates.)
  buildCommand String?
  // A single command line, run through `sh -c` as the container's process
  // instead of whatever the image would have started. Null = the image decides.
  //
  // Applied at RUN time (the machine's init replaces the image's entrypoint and
  // command both), never baked into an image — so it causes no build, and a
  // service that only runs an `image` keeps its build-less deploy while still
  // being able to say how to start.
  startCommand String?
  // Note there is deliberately no dev command here: `devCommand` in the deploy
  // file's `services` export is consumed locally by `hexclave dev
  // --service-id`, and the backend never acts on it, so storing it would only
  // buy a display row in the dashboard at the price of a column that can drift
  // from the deploy file.
  //
  // Array of [env var key, DeploymentEnvVarDefinition] entries (see
  // @hexclave/shared/dist/deployments). An entry array, rather than a JSON object, preserves
  // special keys such as `__proto__` through Prisma's JSON serializer:
  // { value } for plain vars,
  // { type: "secret", key } for secrets (never their values, and never their
  // `secret(key, default)` fallbacks — those travel with the deploy request
  // and are rejected by deploymentEnvVarSchema on every write path),
  // { type: "connection", value } for service-output references.
  env Json @default("{}")

  tenancy Tenancy           @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  source DeploymentSource @relation(fields: [tenancyId, sourceRowId], references: [tenancyId, id], onDelete: Cascade)

  @@id([tenancyId, id])
  @@unique([tenancyId, serviceId])
  @@index([tenancyId, sourceRowId])
}

model DeploymentVolume {
  tenancyId String @db.Uuid

  id String @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceRowId String @db.Uuid

  // The author-chosen id (the key of `persistentVolumes` in the deploy file),
  // which names the underlying Fly volume. Unique within the deployment source, which is
  // what OWNS the disk: a service that stops being declared is torn down, and
  // its disk survives here for a later deploy to mount again.
  volumeId String
  // Provisioned size in whole gigabytes. Grow-only — Fly rejects a shrink, and
  // shrinking would mean destroying tenant data.
  sizeGb Int

  // The service currently mounting it, and where. Both null = unattached: the
  // disk exists (and is still billed) but no service declares it. They are a
  // pair and are always written together.
  serviceId String?
  path      String?

  tenancy Tenancy           @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  source DeploymentSource @relation(fields: [tenancyId, sourceRowId], references: [tenancyId, id], onDelete: Cascade)

  @@id([tenancyId, id])
  @@unique([tenancyId, sourceRowId, volumeId])
  // One disk, one holder: two services asking to mount the same volume would
  // ask Fly to attach it to two machines. Project-wide rather than per source,
  // because service ids are.
  @@unique([tenancyId, serviceId])
}

model DeploymentDomain {
  tenancyId String @db.Uuid

  id String @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Per-TENANCY, not per-service: the deployments runtime holds exactly one
  // claim per hostname, so two services both holding a row for one hostname
  // would leave the loser advertising a verified URL that routes to the winner.
  hostname String

  // What the hostname points at: a service (ids are unique across the project,
  // so it needs no deployment source to disambiguate) and one of its ports.
  // Both null = unattached, which is what a domain becomes when its service
  // stops being declared — the certificate is kept rather than silently
  // released, and the row waits for someone to re-point or delete it.
  //
  // The port is the target service's standard-ports holder — the one that owns
  // 80/443, which is where a certificate terminates. Stated rather than derived
  // because a domain names an ENDPOINT, not a machine: a public service may
  // declare several ports, and this row has to keep saying which one it meant
  // even after the service changes them.
  //
  // Deliberately NOT a foreign key to DeploymentService: a domain OUTLIVES the
  // service it points at, which is the whole reason it is a table of its own.
  serviceId String?
  port      Int?

  isPrimary Boolean @default(false)
  // Runtime-reported (Marshal) verification state, refreshed whenever the domain is read.
  verified Boolean @default(false)

  tenancy Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  @@id([tenancyId, id])
  @@unique([tenancyId, hostname])
  @@index([tenancyId, serviceId])
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  DEPLOYING
  SUCCEEDED
  FAILED
  CANCELED
}

model Deployment {
  tenancyId String @db.Uuid

  id String @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceRowId String @db.Uuid

  // Monotonic per tenancy, so the dashboard and CLI can say "deployment #47"
  // instead of showing a uuid. Assigned inside the same transaction that
  // creates the row (see createDeployment), which the unique constraint below
  // makes safe against two concurrent deploys picking the same number.
  number Int

  // Free-form descriptor of what triggered the deploy (e.g. "cli").
  triggeredBy String

  status DeploymentStatus @default(QUEUED)
  error  String?

  // The runtime's id for this deployment. Null until the runtime has accepted
  // it.
  //
  // Named "build" for historical reasons: when a deployment builds anything, it
  // builds ONCE — the source tree is uploaded once and every source-built
  // service's image comes out of one builder machine, so the build and its log
  // belong to the deployment rather than to any single service. A deployment
  // whose every service runs an already-built image starts no builder at all and
  // still has an id here; see hasBuildLogs for whether a log exists.
  marshalBuildId String?

  // Whether this deployment produced a BUILD LOG, as the runtime reported when
  // it accepted the deployment. False when every service ran an already-built
  // image: no builder machine started, so there is no log to offer and the
  // dashboard must not show an empty one.
  //
  // Defaults true because every row written before prebuilt images existed was a
  // source build, which is exactly what true means.
  hasBuildLogs Boolean @default(true)

  // What this deploy PACKAGED: `{ file_count, total_bytes, compressed_bytes,
  // entries: [{ path, bytes }] }` (see DeploymentSourceManifest in
  // packages/shared/src/deployments). A listing, never contents — the tarball
  // itself is consumed by the build and deleted, so this is what survives it to
  // answer "why was my upload this big, and did my .dockerignore work".
  //
  // Null for an all-prebuilt deploy (nothing was packaged) and for every row
  // written before the manifest existed. Capped at MAX_SOURCE_MANIFEST_ENTRIES
  // files, largest first, so the column stays small on a repository with tens of
  // thousands of files.
  sourceManifest Json?

  // The service ids this deploy INTENDED to ship, in dependency order, as a
  // JSON string array — kept separately from the outcomes below because a
  // service can fail before it has an outcome at all.
  plannedServiceIds Json @default("[]")

  // What each service actually did in THIS deploy, as a JSON object keyed by
  // service id: `{ status, url, revision, error }` (see DeploymentServiceOutcome).
  // A deployment is the unit of history, so the outcomes live on it rather than
  // in rows of their own — nothing queries a single service's timeline except
  // through the deployments of its source.
  services Json @default("{}")

  // `{ edkBase64, ciphertextBase64 }`, encrypting a JSON string array of the
  // exact sensitive values injected into this deploy. Build logs are fetched
  // from the runtime (Marshal) on demand, potentially after a project secret was
  // rotated or deleted; keeping the encrypted snapshot here lets those
  // historical logs stay redacted without retaining the old value in ProjectSecret.
  redactionSecretsEncrypted Json?

  finishedAt DateTime?

  // Set when the client owning this deploy reports that it has stopped working
  // on it (see the conclude route). A planned service with no outcome normally
  // reads as "still going" — but a client can fail before reporting anything at
  // all (packaging, upload, a crash), which leaves nothing to derive a terminal
  // state from. This column is what says "nothing further is coming"; without it
  // such a deployment stays queued forever and the dashboard polls it
  // indefinitely.
  concludedAt DateTime?

  tenancy Tenancy           @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  source DeploymentSource @relation(fields: [tenancyId, sourceRowId], references: [tenancyId, id], onDelete: Cascade)

  @@id([tenancyId, id])
  @@unique([tenancyId, number])
  @@index([tenancyId, createdAt(sort: Desc)])
  @@index([tenancyId, sourceRowId, createdAt(sort: Desc)])
}

model DeploymentSourceUpload {
  tenancyId String @db.Uuid

  id String @default(uuid()) @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The upload slot id in Marshal's bucket (passed as the spec's source).
  marshalUploadId String
  expiresAt       DateTime

  tenancy Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  @@id([tenancyId, id])
  @@index([expiresAt])
}


// ─── Workflows ──────────────────────────────────────────────────────────────
//
// Durable, event-triggered workflows (Hexclave Workflows v1). All tables are
// fully multi-tenant and available to every project: the alpha-stage
// `workflows-alpha` app controls dashboard visibility only, and — as with every
// other app — the API is not gated on it being installed.
//
// The engine is tick-driven like the email queue: a cron route claims due
// work with FOR UPDATE SKIP LOCKED, invokes sandboxes (js-execution), and
// records step results. See apps/backend/src/lib/workflows/.

model WorkflowDefinition {
  tenancyId String @db.Uuid
  tenancy   Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  // User-chosen slug (e.g. "welcome-drip"). Deliberately not a uuid: it is
  // the stable business identity of the workflow across versions, and the
  // handle used by the management API (cancelRuns({ workflow: ... })).
  workflowId String

  displayName String

  // Denormalized copy of the highest WorkflowVersion.version. The sync route
  // is the only writer of versions, and it updates this in the same
  // transaction that inserts the version row.
  latestVersion Int

  // Pause state. While `pausedAt` is set the workflow accepts no new runs:
  // matching events are still consumed from the outbox, they just do not
  // dispatch to this definition. In-flight runs are untouched — pausing
  // stops the intake, it does not halt work already underway.
  //
  // The gate is evaluated when the engine processes an event, not against the
  // event's own timestamp, so an event enqueued moments before a resume can
  // still dispatch if no tick reached it while the workflow was paused. That
  // boundary is deliberately approximate.
  pausedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([tenancyId, workflowId])
}

model WorkflowVersion {
  tenancyId  String @db.Uuid
  tenancy    Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  workflowId String
  // Platform-assigned, monotonically increasing per workflow per tenancy
  // (v1, v2, ...). Never author-declared.
  version Int

  // The raw source string as authored in the dashboard editor. The version
  // hash is over (source, runtimeEnvVersion): a version is minted whenever
  // either changes.
  source     String
  sourceHash String

  // esbuild output of (runtime shim + user source), bundled at sync time and
  // stored per version so that pinned runs execute byte-identical code
  // forever. Only the pinned stdlib (date-fns) stays an external import,
  // installed into the sandbox via nodeModules at the exact version recorded
  // in runtimeEnvVersion's pin table.
  compiledBundle String

  // Version tag of the platform-provided runtime environment (runtime shim +
  // stdlib pins) this version was synced against. Pinned runs execute
  // against their recorded env; env upgrades apply to new versions only.
  // See WORKFLOWS_RUNTIME_ENVS in apps/backend/src/lib/workflows/runtime-env.tsx.
  runtimeEnvVersion String

  // WorkflowManifest (packages/shared/src/interface/workflows.ts), extracted
  // by executing the compiled bundle in manifest mode at sync time: triggers,
  // hasRunKey, onConflict, usesStdlib. This is what event dispatch matches
  // against, so trigger declarations are data here, never re-evaluated code.
  manifest Json

  createdAt DateTime @default(now())

  @@id([tenancyId, workflowId, version])
}

enum WorkflowRunState {
  QUEUED
  RUNNING
  SLEEPING
  COMPLETED
  FAILED
  CANCELED
}

// Which error channel a failure belongs to. USER failures (handler/step code
// threw) surface in run history with their message; PLATFORM failures
// (sandbox provisioning, engine bugs) are reported to our monitoring and
// surface to users only as a generic platform error.
enum WorkflowRunFailureKind {
  USER
  PLATFORM
}

model WorkflowRun {
  tenancyId String @db.Uuid
  tenancy   Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  // Platform UUID for history: runKeys recur over time, UUIDs never.
  id String @default(uuid()) @db.Uuid

  workflowId String
  // The version this run is pinned to. Set at creation to the then-latest
  // version; changed only by an explicit upgradeRuns action.
  version Int

  // Business key derived from the trigger event at run creation (before any
  // execution). Unique per workflow among ACTIVE runs — see the isActive
  // generated column below. Null for keyless runs. Capped at 512 chars at
  // creation time to keep the unique index well below btree limits.
  runKey String?

  state WorkflowRunState @default(QUEUED)

  // Generated column (see migration): TRUE while state is one of
  // QUEUED/RUNNING/SLEEPING, NULL otherwise. Exists solely so the
  // active-run-per-runKey uniqueness below can be an ordinary unique index
  // (NULLs never collide), the same trick as Tenancy.hasNoOrganization.
  // NOTE: Prisma only applies dbgenerated() as a DEFAULT; the migration
  // hand-writes the actual GENERATED ALWAYS AS ... STORED column, and this
  // declaration must be kept in sync with it. The string below must be the
  // expression as Postgres *renders it back*, not as the migration writes it:
  // Postgres parses the expression and re-deparses it, so `IN (...)` becomes
  // `= ANY (ARRAY[...])`, literals gain explicit casts, and it is pretty-printed
  // with a leading newline. `prisma migrate diff` (the check in CI) compares
  // these strings literally, so the source form drifts forever. Get the exact
  // text with:
  //   SELECT pg_get_expr(d.adbin, d.adrelid) FROM pg_attrdef d
  //     JOIN pg_attribute a ON a.attrelid = d.adrelid AND a.attnum = d.adnum
  //     WHERE d.adrelid = '"WorkflowRun"'::regclass AND a.attname = 'isActive';
  // Dropping the dbgenerated() entirely does not work either — diff then reports
  // the default changing to None. Same deal as the EmailOutbox generated columns.
  isActive Boolean? @default(dbgenerated("\nCASE\n    WHEN (state = ANY (ARRAY['QUEUED'::\"WorkflowRunState\", 'RUNNING'::\"WorkflowRunState\", 'SLEEPING'::\"WorkflowRunState\"])) THEN true\n    ELSE NULL::boolean\nEND"))

  // The id of the WorkflowEvent that triggered this run. Not a foreign key
  // on purpose: events are retention-pruned independently of runs, and the
  // id must survive as a value (it identifies the trigger event).
  // triggerType/triggerPayload are denormalized snapshots because the
  // handler replays against them on every invocation.
  triggerEventId String? @db.Uuid
  triggerType    String
  // Envelope { ts_millis: number, data: <event payload> } — ts_millis is the
  // trigger event's scheduledAt, which becomes event.ts in the handler.
  triggerPayload Json

  // The step the run is currently parked on: the sleep step while SLEEPING,
  // the step being retried while QUEUED with attempts > 0, the last known
  // executing step while RUNNING. Null at creation and after each recorded
  // step. Used by upgrade divergence decisions (a sleeping run can only
  // transfer to code that reaches the same sleep) and the dashboard.
  currentStepKey String?

  // When the run next needs engine attention: QUEUED = ready (or waiting out
  // a retry backoff), SLEEPING = durable timer. Null while RUNNING (leased).
  wakeAt DateTime?
  // Lease for crash recovery: a RUNNING run whose lease expired is re-claimed
  // by a later tick. Re-claiming re-executes from the last committed step, so
  // step execution is at-least-once (a crashed worker may re-run a step).
  leaseUntil DateTime?
  // Fencing token, rotated on every claim: post-invocation transitions
  // require the claimant's token, so a stale worker that lost its lease
  // (paused mid-await past expiry) can no longer clobber the new claimant's
  // state. Cancel/upgrade/retry deliberately do NOT check it — they act on
  // state, and the engine's guarded transitions observe the result.
  leaseToken String? @db.Uuid

  // Attempt counter for the step currently being executed; reset to 0
  // whenever a step result is recorded. 4 attempts max (1 + 3 retries).
  currentStepAttempt Int @default(0)

  // How many times an operator has manually retried this run from its failed
  // step. Manual retry grants a fresh attempt budget (currentStepAttempt goes
  // back to 0), so without this the re-executed attempts would reuse attempt
  // numbers that already exist for the same step and collide with the
  // WorkflowStepAttempt primary key — silently discarding the new history via
  // its skipDuplicates insert. Bumping the epoch keeps every execution's
  // attempts as distinct rows, so a retried run shows what actually happened
  // rather than only its original failure.
  retryEpoch Int @default(0)

  // Running total of recorded step result sizes, to enforce the 4 MiB
  // total-memoized-state-per-run limit without summing on every step.
  memoTotalBytes Int @default(0)

  failureKind  WorkflowRunFailureKind?
  errorSummary String?

  // Machine-readable diagnostic from the most recent skipped upgradeRuns
  // attempt (expected vs found step graph). Cleared on successful upgrade.
  lastUpgradeDivergence Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  stepResults  WorkflowStepResult[]
  stepAttempts WorkflowStepAttempt[]

  @@id([tenancyId, id])
  // runKey/onConflict enforcement: at most one ACTIVE run per (workflow,
  // runKey). isActive is NULL for terminal runs and runKey is NULL for
  // keyless runs, so neither ever conflicts.
  @@unique([tenancyId, workflowId, runKey, isActive], map: "WorkflowRun_active_run_key")
  // Run-list queries (dashboard/API): filter by workflow + state, newest first.
  @@index([tenancyId, workflowId, state, createdAt(sort: Desc)], map: "WorkflowRun_list_idx")
  // Engine due-work scan (cross-tenancy): QUEUED/SLEEPING by wakeAt, plus
  // expired-lease recovery on RUNNING by leaseUntil.
  @@index([state, wakeAt], map: "WorkflowRun_due_idx")
  @@index([state, leaseUntil], map: "WorkflowRun_lease_idx")
  // Version fan-out ("214 runs on v7, 3 on v8") per workflow.
  @@index([tenancyId, workflowId, version, state], map: "WorkflowRun_version_idx")
}

enum WorkflowStepKind {
  RUN
  SLEEP
}

model WorkflowStepResult {
  tenancyId String @db.Uuid
  runId     String @db.Uuid

  // The memoization key: the user-written step id, suffixed with "#<n>" by
  // the runtime when the same id executes more than once (loop counter).
  // CONTRACT: a step key names a recorded fact; matching is by key only,
  // order-independent.
  stepKey String

  // The user-written step id without the loop counter suffix (for display).
  stepId String
  kind   WorkflowStepKind

  // RUN: the JSON return value of the step callback (<= 1 MiB, enforced with
  // an explicit error). SLEEP: { until: <ISO timestamp> }.
  result          Json?
  resultSizeBytes Int

  // How many attempts it took to record this fact (1 = first try).
  attempts Int
  // Which workflow version's code executed this step (observability; differs
  // from the run's current version after an upgrade).
  executedAtVersion Int
  elapsedMs         Int?

  createdAt DateTime @default(now())

  run WorkflowRun @relation(fields: [tenancyId, runId], references: [tenancyId, id], onDelete: Cascade)

  @@id([tenancyId, runId, stepKey])
}

enum WorkflowStepAttemptOutcome {
  SUCCEEDED
  FAILED
}

// One row per sandbox invocation attempt of a step, for observability
// (sandbox logs + error history per attempt). Kept separate from
// WorkflowStepResult because failed attempts are history, not facts.
model WorkflowStepAttempt {
  tenancyId String @db.Uuid
  runId     String @db.Uuid
  stepKey   String
  // WorkflowRun.retryEpoch at the time of this attempt. Part of the key
  // because a manual retry restarts attempt numbering at 1 for the same step.
  retryEpoch Int @default(0)
  attempt    Int

  stepId  String
  outcome WorkflowStepAttemptOutcome
  // { name, message, stack } of the user-code error if FAILED with
  // failureKind USER; a generic marker for PLATFORM failures.
  error       Json?
  failureKind WorkflowRunFailureKind?
  // console output captured inside the sandbox by the runtime shim, capped
  // at 64 KiB per attempt.
  logs String?

  startedAt  DateTime
  finishedAt DateTime
  createdAt  DateTime @default(now())

  run WorkflowRun @relation(fields: [tenancyId, runId], references: [tenancyId, id], onDelete: Cascade)

  @@id([tenancyId, runId, stepKey, retryEpoch, attempt])
}

// The workflow event outbox. Platform events are inserted transactionally
// with the entity mutation at the webhook call sites (at-least-once from our
// own tables); custom events via workflows.send(); schedule occurrences are
// materialized by the engine; lifecycle events (workflow.run.*) are inserted
// on run state transitions.
model WorkflowEvent {
  tenancyId String @db.Uuid
  tenancy   Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  id        String @default(uuid()) @db.Uuid

  // Wire type: platform events are unprefixed ("user.created"), custom
  // events are always "custom.*", lifecycle events are "workflow.run.*",
  // schedule occurrences are "schedule".
  type    String
  payload Json

  // For schedule occurrences: the cron tick's nominal time (may be in the
  // past when catching up after downtime). Everything else: creation time.
  // The outbox processes events in ascending scheduledAt order, which is
  // what guarantees delayed-never-skipped schedule catch-up.
  scheduledAt DateTime  @default(now())
  processedAt DateTime?
  // Failed dispatches back off so one poison event cannot monopolize the
  // oldest outbox batch and starve unrelated tenants forever.
  processingAttempts Int      @default(0)
  retryAt            DateTime @default(now())

  createdAt DateTime @default(now())

  @@id([tenancyId, id])
  // Outbox scan: unprocessed events in scheduledAt order. processedAt is the
  // leading column so the scan stays cheap as processed events accumulate
  // (IS NULL rows are contiguous in the index).
  @@index([processedAt, retryAt, scheduledAt], map: "WorkflowEvent_outbox_idx")
  // Retention pruning + per-tenancy event views.
  @@index([tenancyId, createdAt], map: "WorkflowEvent_tenancy_created_idx")
}

// Cursor for schedule() trigger materialization. One row per schedule
// trigger per workflow; scheduleKey is "<cron>|<timezone>" so editing a
// schedule starts a fresh cursor (no retroactive catch-up of the new
// expression).
model WorkflowScheduleCursor {
  tenancyId   String @db.Uuid
  tenancy     Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  workflowId  String
  scheduleKey String

  lastMaterializedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([tenancyId, workflowId, scheduleKey])
}
