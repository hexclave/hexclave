// Append-only admin audit trail for the opt-in Audit Log app. Writes are gated
// on apps.installed.audit-log.enabled in application code so uninstalling the
// app stops new events without requiring a schema change.
model AuditLogEvent {
  tenancyId String  @db.Uuid
  id        String  @default(uuid()) @db.Uuid
  tenancy   Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  action String

  actorType   String
  actorUserId String? @db.Uuid
  actorLabel  String

  // Null for project-scoped events (e.g. settings changes) that aren't about a user.
  targetUserId String? @db.Uuid
  reason       String?
  metadata     Json?

  @@id([tenancyId, id])
  @@index([tenancyId, createdAt(sort: Desc)])
  @@index([tenancyId, action, createdAt(sort: Desc)])
}

model CacheEntry {
  id        String   @id @default(uuid()) @db.Uuid
  namespace String
  cacheKey  String
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([namespace, cacheKey])
}

model SubscriptionInvoice {
  id                            String  @default(uuid()) @db.Uuid
  tenancyId                     String  @db.Uuid
  stripeSubscriptionId          String
  stripeInvoiceId               String
  isSubscriptionCreationInvoice Boolean
  status                        String?
  amountTotal                   Int?
  hostedInvoiceUrl              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription @relation(fields: [tenancyId, stripeSubscriptionId], references: [tenancyId, stripeSubscriptionId])

  @@id([tenancyId, id])
  @@unique([tenancyId, stripeInvoiceId])
}

// Durable backup of Bulldozer `payments-manual-transactions` (refunds today).
// Dual-written from the refund routes; also filled by a one-off HTTP export from
// Bulldozer so history survives an LMDB rebuild/backfill.
model ManualTransaction {
  tenancyId       String       @db.Uuid
  txnId           String
  type            String
  customerId      String
  customerType    CustomerType
  paymentProvider String?
  effectiveAt     DateTime
  createdAt       DateTime
  entries         Json

  @@id([tenancyId, txnId])
  @@index([tenancyId, createdAt])
