{
  "name": "@hexclave/growth-agent",
  "version": "1.0.103",
  "repository": "https://github.com/hexclave/hexclave",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#*": "./agent/*"
  },
  "scripts": {
    "with-env": "dotenv -c --",
    "with-env:dev": "dotenv -c development --",
    "dev": "node scripts/reset-local-workflows.ts && dotenv -c development -- eve dev --no-ui --port ${NEXT_PUBLIC_HEXCLAVE_PORT_PREFIX:-81}49",
    "build": "eve build",
    "start": "eve start",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts .",
    "clean": "rimraf node_modules"
  },
  "dependencies": {
    "@agent-browser/eve": "0.32.4",
    "ai": "7.0.66",
    "eve": "0.38.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "dotenv-cli": "^7.3.0",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.5.0"
}
