# Export NEXT_PUBLIC_HEXCLAVE_PORT_PREFIX in your terminal (the dev script reads it
# from the shell, not from this file) to use alternate dev ports. If you set a
# custom prefix, update this API URL and BETTER_AUTH_URL together. Next.js
# expands $VARIABLE references in .env files, but cannot compute a port from a
# prefix using string arithmetic, so these URLs must be aligned by hand.
NEXT_PUBLIC_HEXCLAVE_API_URL=http://localhost:8102
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID=internal
NEXT_PUBLIC_HEXCLAVE_PUBLISHABLE_CLIENT_KEY=this-publishable-client-key-is-for-local-development-only
HEXCLAVE_SECRET_SERVER_KEY=this-secret-server-key-is-for-local-development-only
BETTER_AUTH_SECRET=local-only-better-auth-secret
# Keep this port aligned with NEXT_PUBLIC_HEXCLAVE_PORT_PREFIX.
BETTER_AUTH_URL=http://localhost:8114
