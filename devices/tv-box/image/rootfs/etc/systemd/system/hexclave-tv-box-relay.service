[Unit]
Description=Hexclave TV Box optional outbound support transport
Requires=hexclave-tv-box-firstboot.service hexclave-tv-box-relay-identity.service
After=hexclave-tv-box-firstboot.service hexclave-tv-box-relay-identity.service network.target ssh.service
ConditionPathExists=/var/lib/hexclave-tv-box/relay/enrollment.json
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=hexclave-tv-relay
Group=hexclave-tv-relay
SupplementaryGroups=hexclave-tv-runtime
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m hexclave_tv_box.relay
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=30
TimeoutStopSec=15
KillMode=control-group
RuntimeDirectory=hexclave-tv-box-relay
RuntimeDirectoryMode=0700
UMask=0077
Nice=10
CPUWeight=10
IOWeight=10
TasksMax=16
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
ReadOnlyPaths=/var/lib/hexclave-tv-box/relay
ReadWritePaths=/run/hexclave-tv-box-relay

[Install]
WantedBy=multi-user.target
