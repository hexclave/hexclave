[Unit]
Description=Hexclave TV Box optional outbound support transport
Requires=hexclave-tv-box-firstboot.service hexclave-tv-box-relay-identity.service
After=hexclave-tv-box-firstboot.service hexclave-tv-box-relay-identity.service
ConditionPathExists=/var/lib/hexclave-tv-box/relay/enrollment.json
# Backoff bounds retries without permanently abandoning an extended outage.
StartLimitIntervalSec=0

[Service]
Type=exec
User=hexclave-tv-relay
Group=hexclave-tv-relay
SupplementaryGroups=hexclave-tv-runtime
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m hexclave_tv_box.relay
Restart=always
RestartPreventExitStatus=78
RestartSec=5s
RestartSteps=6
RestartMaxDelaySec=5min
TimeoutStopSec=15
KillMode=control-group
# The launcher execs SSH in place. Neither untrusted server banners nor raw
# SSH errors enter the journal; systemd records lifecycle and exit status.
StandardInput=null
StandardOutput=null
StandardError=null
UMask=0077
Nice=10
CPUWeight=10
IOWeight=10
TasksMax=16
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
ReadOnlyPaths=/var/lib/hexclave-tv-box/relay

[Install]
WantedBy=multi-user.target
